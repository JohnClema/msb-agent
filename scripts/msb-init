#! /usr/bin/env bash

# Copy the agent project template into this PWD (never overwrites)

TEMPLATE_DIR="$(cd "$(dirname "$(realpath "$0")")/../template" && pwd)"

cd "$TEMPLATE_DIR" || exit 1

find . -type f | while read -r file; do
  target="$OLDPWD/${file#./}"
  if [[ -e "$target" ]]; then
    echo "skip   ${file#./} (exists)"
  else
    mkdir -p "$(dirname "$target")"
    cp -p "$file" "$target"
    echo "create ${file#./}"
  fi
done

# Claude Code reads CLAUDE.md; point it at the shared AGENTS.md
if [[ ! -e "$OLDPWD/CLAUDE.md" ]]; then
  ln -s AGENTS.md "$OLDPWD/CLAUDE.md"
  echo "create CLAUDE.md -> AGENTS.md"
fi
